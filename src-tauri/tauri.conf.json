{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AIPet",
  "version": "0.1.0",
  "identifier": "local.aipet.desktop-pet",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "桌宠",
        "url": "pet.html",
        "width": 192,
        "height": 208,
        "transparent": true,
        "backgroundColor": "#00000000",
        "decorations": false,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "visible": true
      },
      {
        "label": "settings",
        "title": "AIPet设置",
        "url": "settings.html",
        "width": 780,
        "height": 520,
        "transparent": false,
        "backgroundColor": "#f6f7f9",
        "decorations": true,
        "resizable": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "displayLanguageSelector": false
      }
    }
  }
}
